<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC Permissions (T004) -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!-- Alarm Permissions (T005) -->
    <!-- For API 31+ (Android 12+): exact alarm scheduling -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    
    <!-- Boot receiver to reschedule alarms after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notification Permissions (T006) -->
    <!-- For API 33+ (Android 13+): post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Future emergency contact features (Phase 12 - User Story 6) -->
    <!-- T245: SMS permission for emergency notifications -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    
    <!-- T246: Call permission for emergency calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    
    <!-- T247: Location for emergency notifications -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedCheckTag"
        tools:targetApi="31">

        <!-- MainActivity will be added in Phase 4 (User Story 3) -->
        <!-- Activities, Receivers, Services will be registered here as implemented -->

        <!-- Main Activity (T079 - Phase 4, User Story 3) - Launcher Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- T091: NFC intent filters for tag discovery -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings Activity (Phase 4, User Story 3) -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Add Medication Activity (T060 - Phase 3, User Story 2) -->
        <activity
            android:name=".ui.medication.AddMedicationActivity"
            android:exported="false"
            android:label="Add Medication"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Medication Info Activity (T166 - Phase 8, User Story 10) -->
        <activity
            android:name=".ui.medication.MedicationInfoActivity"
            android:exported="false"
            android:label="Medication Details"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Edit Medication Activity (T192 - Phase 10, User Story 9) -->
        <activity
            android:name=".ui.medication.EditMedicationActivity"
            android:exported="false"
            android:label="Edit Medication"
            android:parentActivityName=".ui.medication.MedicationInfoActivity" />

        <!-- Alarm Receiver (T037, T039) -->
        <receiver
            android:name=".alarms.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot Receiver (T038, T039) - Reschedules alarms after reboot -->
        <receiver
            android:name=".alarms.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
